# ============================================================================
# Arrow Puzzle — .gitignore
# ============================================================================
# IMPORTANT: This file intentionally EXCLUDES sensitive secrets and large
# build artifacts. Never commit:
#   - The signing keystore (.jks) — leak = anyone can ship updates as you
#   - Local properties files with absolute paths
#   - node_modules / build outputs (regenerated by `npm install` / `npm run build`)
# ============================================================================

# ---------- Secrets & credentials (NEVER commit) ----------
*.jks
*.keystore
*.p12
*.pfx
*.key
*.pem
keystore.properties
KEYSTORE-DETAILS.txt
.env
.env.local
.env.production
.env.development
.env.example.local

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.pnp
.pnp.js
bun.lockb

# ---------- Next.js ----------
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# ---------- Capacitor / Android ----------
android/app/src/main/assets/public/
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties
android/capacitor.build.gradle
android/capacitor.settings.gradle
android/app/capacitor.build.gradle
*.apk
*.aab
*.apks
*.dex
*.class

# ---------- Gradle ----------
.gradle/
gradle-app.setting
!gradle-wrapper.jar
.gradletasknamecache

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- OS / Misc ----------
*.log
logs/
.cache/
.temp/
tmp/
*.bak
*.tmp

# ---------- SQLite / Prisma ----------
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/migrations/dev.db*

# ---------- Test / Coverage ----------
coverage/
.nyc_output
*.lcov

# ---------- Misc ----------
.dockerignore
Dockerfile
docker-compose.yml
